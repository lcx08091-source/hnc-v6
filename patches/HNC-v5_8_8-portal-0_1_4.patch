+
+func defaultPortalConfig() portalConfig {
+	return portalConfig{Version: 1, Enabled: false, PortalPort: portalDefaultPort, SessionTTLSeconds: portalDefaultSessionTTL, AutoApprove: false}
+}
+
+func (c *portalConfig) normalize() {
+	if c.Version == 0 {
+		c.Version = 1
+	}
+	if c.PortalPort <= 0 {
+		c.PortalPort = portalDefaultPort
+	}
+	if c.SessionTTLSeconds <= 0 {
+		c.SessionTTLSeconds = portalDefaultSessionTTL
+	}
+}
+
+func (s *server) portalConfigPath() string  { return filepath.Join(s.hncDir, "data", "portal_config.json") }
+func (s *server) portalSessionsPath() string { return filepath.Join(s.hncDir, "run", "portal_sessions.json") }
+func (s *server) portalPendingPath() string  { return filepath.Join(s.hncDir, "run", "portal_pending.json") }
+func (s *server) portalChatPath() string     { return filepath.Join(s.hncDir, "logs", "portal_chat.jsonl") }
+func (s *server) portalAuditPath() string    { return filepath.Join(s.hncDir, "logs", "portal_audit.jsonl") }
+
+func (s *server) ensurePortalData() error {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	for _, d := range []string{filepath.Join(s.hncDir, "data"), filepath.Join(s.hncDir, "run"), filepath.Join(s.hncDir, "logs")} {
+		if err := os.MkdirAll(d, 0o755); err != nil {
+			return err
+		}
+	}
+	if _, err := os.Stat(s.portalConfigPath()); os.IsNotExist(err) {
+		cfg := defaultPortalConfig()
+		if err := writeJSONAtomic(s.portalConfigPath(), &cfg); err != nil {
+			return err
+		}
+	}
+	if _, err := os.Stat(s.portalSessionsPath()); os.IsNotExist(err) {
+		if err := writeJSONAtomic(s.portalSessionsPath(), map[string]portalSession{}); err != nil {
+			return err
+		}
+	}
+	if _, err := os.Stat(s.portalPendingPath()); os.IsNotExist(err) {
+		if err := writeJSONAtomic(s.portalPendingPath(), map[string]portalPending{}); err != nil {
+			return err
+		}
+	}
+	for _, p := range []string{s.portalChatPath(), s.portalAuditPath()} {
+		f, err := os.OpenFile(p, os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+		if err != nil {
+			return err
+		}
+		_ = f.Close()
+	}
+	return nil
+}
+
+func portalKey(ip, mac string) string {
+	return strings.TrimSpace(ip) + "|" + portalNormalizeMAC(mac)
+}
+
+func portalNormalizeMAC(mac string) string {
+	return strings.ToLower(strings.TrimSpace(mac))
+}
+
+func portalValidMAC(mac string) bool {
+	mac = portalNormalizeMAC(mac)
+	return validMAC(mac)
+}
+
+func portalValidIPv4(ip string) bool {
+	p := net.ParseIP(strings.TrimSpace(ip))
+	return p != nil && p.To4() != nil
+}
+
+func (s *server) portalReadConfigUnlocked() portalConfig {
+	cfg := defaultPortalConfig()
+	if err := readJSONInto(s.portalConfigPath(), &cfg); err != nil {
+		log.Printf("portal: read config failed, using defaults: %v", err)
+	}
+	cfg.normalize()
+	return cfg
+}
+
+func (s *server) portalLoadConfig() portalConfig {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	return s.portalReadConfigUnlocked()
+}
+
+func (s *server) portalWriteConfigUnlocked(cfg portalConfig) error {
+	cfg.normalize()
+	return writeJSONAtomic(s.portalConfigPath(), &cfg)
+}
+
+func (s *server) portalLoadSessionsUnlocked() map[string]portalSession {
+	m := map[string]portalSession{}
+	if err := readJSONInto(s.portalSessionsPath(), &m); err != nil {
+		log.Printf("portal: read sessions failed: %v", err)
+	}
+	if m == nil {
+		m = map[string]portalSession{}
+	}
+	return m
+}
+
+func (s *server) portalWriteSessionsUnlocked(m map[string]portalSession) error {
+	if m == nil {
+		m = map[string]portalSession{}
+	}
+	return writeJSONAtomic(s.portalSessionsPath(), m)
+}
+
+func (s *server) portalLoadPendingUnlocked() map[string]portalPending {
+	m := map[string]portalPending{}
+	if err := readJSONInto(s.portalPendingPath(), &m); err != nil {
+		log.Printf("portal: read pending failed: %v", err)
+	}
+	if m == nil {
+		m = map[string]portalPending{}
+	}
+	return m
+}
+
+func (s *server) portalWritePendingUnlocked(m map[string]portalPending) error {
+	if m == nil {
+		m = map[string]portalPending{}
+	}
+	return writeJSONAtomic(s.portalPendingPath(), m)
+}
+
+func (s *server) portalFindSession(ip, mac string) (portalSession, bool) {
+	now := time.Now().Unix()
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	for _, sess := range s.portalLoadSessionsUnlocked() {
+		if sess.IP != ip {
+			continue
+		}
+		if mac != "" && !strings.EqualFold(sess.MAC, mac) {
+			continue
+		}
+		if sess.ExpiresAt > now {
+			return sess, true
+		}
+	}
+	return portalSession{}, false
+}
+
+func (s *server) portalFindPending(ip, mac string) (portalPending, bool) {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	pending := s.portalLoadPendingUnlocked()
+	if mac != "" {
+		if p, ok := pending[portalKey(ip, mac)]; ok {
+			return p, true
+		}
+	}
+	for _, p := range pending {
+		if p.IP == ip && (mac == "" || p.MAC == "" || strings.EqualFold(p.MAC, mac)) {
+			return p, true
+		}
+	}
+	return portalPending{}, false
+}
+
+func (s *server) portalUpsertPending(p portalPending) error {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	m := s.portalLoadPendingUnlocked()
+	now := time.Now().Unix()
+	if p.CreatedAt == 0 {
+		p.CreatedAt = now
+	}
+	p.UpdatedAt = now
+	m[portalKey(p.IP, p.MAC)] = p
+	return s.portalWritePendingUnlocked(m)
+}
+
+func (s *server) portalDeleteSession(ip, mac string) (portalSession, bool, error) {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	m := s.portalLoadSessionsUnlocked()
+	var removed portalSession
+	found := false
+	for k, sess := range m {
+		if sess.IP == ip && (mac == "" || strings.EqualFold(sess.MAC, mac)) {
+			removed = sess
+			delete(m, k)
+			found = true
+		}
+	}
+	return removed, found, s.portalWriteSessionsUnlocked(m)
+}
+
+func (s *server) portalSaveSession(sess portalSession) error {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	m := s.portalLoadSessionsUnlocked()
+	m[portalKey(sess.IP, sess.MAC)] = sess
+	pending := s.portalLoadPendingUnlocked()
+	delete(pending, portalKey(sess.IP, sess.MAC))
+	for k, p := range pending {
+		if p.IP == sess.IP && (p.MAC == "" || strings.EqualFold(p.MAC, sess.MAC)) {
+			delete(pending, k)
+		}
+	}
+	if err := s.portalWriteSessionsUnlocked(m); err != nil {
+		return err
+	}
+	return s.portalWritePendingUnlocked(pending)
+}
+
+func (s *server) portalSetEnabled(enabled bool) error {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	cfg := s.portalReadConfigUnlocked()
+	cfg.Enabled = enabled
+	return s.portalWriteConfigUnlocked(cfg)
+}
+
+func (s *server) portalAppendChat(msg portalChatMessage) error {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	if msg.TS == 0 {
+		msg.TS = time.Now().Unix()
+	}
+	if msg.ID == "" {
+		msg.ID = fmt.Sprintf("%d-%s-%s", msg.TS, msg.From, strings.ReplaceAll(msg.MAC, ":", ""))
+	}
+	if msg.From == "" {
+		msg.From = "user"
+	}
+	data, err := json.Marshal(msg)
+	if err != nil {
+		return err
+	}
+	f, err := os.OpenFile(s.portalChatPath(), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+	_, err = f.Write(append(data, '\n'))
+	return err
+}
+
+func (s *server) portalAppendAudit(a portalAuditEntry) {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	if a.TS == 0 {
+		a.TS = time.Now().Unix()
+	}
+	data, err := json.Marshal(a)
+	if err != nil {
+		log.Printf("portal audit marshal: %v", err)
+		return
+	}
+	f, err := os.OpenFile(s.portalAuditPath(), os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0o644)
+	if err != nil {
+		log.Printf("portal audit open: %v", err)
+		return
+	}
+	defer f.Close()
+	_, _ = f.Write(append(data, '\n'))
+}
+
+func (s *server) portalMessagesFor(ip, mac string, limit int) []portalChatMessage {
+	if limit <= 0 {
+		limit = 100
+	}
+	f, err := os.Open(s.portalChatPath())
+	if err != nil {
+		return nil
+	}
+	defer f.Close()
+	out := []portalChatMessage{}
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 64*1024), 1024*1024)
+	for sc.Scan() {
+		var m portalChatMessage
+		if err := json.Unmarshal(sc.Bytes(), &m); err != nil {
+			continue
+		}
+		if m.IP != ip {
+			continue
+		}
+		if mac != "" && m.MAC != "" && !strings.EqualFold(m.MAC, mac) {
+			continue
+		}
+		out = append(out, m)
+		if len(out) > limit {
+			out = out[len(out)-limit:]
+		}
+	}
+	return out
+}
+
+func (s *server) portalRecentMessages(limit int) []portalChatMessage {
+	if limit <= 0 {
+		limit = 200
+	}
+	f, err := os.Open(s.portalChatPath())
+	if err != nil {
+		return nil
+	}
+	defer f.Close()
+	out := []portalChatMessage{}
+	sc := bufio.NewScanner(f)
+	sc.Buffer(make([]byte, 64*1024), 1024*1024)
+	for sc.Scan() {
+		var m portalChatMessage
+		if err := json.Unmarshal(sc.Bytes(), &m); err != nil {
+			continue
+		}
+		out = append(out, m)
+		if len(out) > limit {
+			out = out[len(out)-limit:]
+		}
+	}
+	return out
+}
+
+func (s *server) portalCheckChatRate(ip string) bool {
+	now := time.Now().Unix()
+	s.portalRateMu.Lock()
+	defer s.portalRateMu.Unlock()
+	st := s.portalChatRate[ip]
+	if st == nil {
+		st = &portalRateState{}
+		s.portalChatRate[ip] = st
+	}
+	if st.LastTS > 0 && now-st.LastTS < portalChatMinSeconds {
+		return false
+	}
+	cutoff := now - 3600
+	kept := st.Hour[:0]
+	for _, ts := range st.Hour {
+		if ts >= cutoff {
+			kept = append(kept, ts)
+		}
+	}
+	st.Hour = kept
+	if len(st.Hour) >= portalChatHourlyLimit {
+		return false
+	}
+	st.LastTS = now
+	st.Hour = append(st.Hour, now)
+	return true
+}
+
+func portalTrimText(s string, maxRunes int) (string, bool) {
+	s = strings.TrimSpace(s)
+	if maxRunes <= 0 {
+		return s, false
+	}
+	r := []rune(s)
+	if len(r) > maxRunes {
+		return string(r[:maxRunes]), true
+	}
+	return s, false
+}
+
+func (s *server) portalManager(args ...string) (int, string) {
+	cfg := s.portalLoadConfig()
+	ctx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
+	defer cancel()
+	cmdArgs := append([]string{filepath.Join(s.hncDir, "bin", "portal_manager.sh")}, args...)
+	cmd := exec.CommandContext(ctx, "sh", cmdArgs...)
+	cmd.Env = append(os.Environ(),
+		"HNC_DIR="+s.hncDir,
+		"HNC="+s.hncDir,
+		"PATH=/system/bin:/system/xbin:/vendor/bin:/usr/bin:/bin",
+		"HNC_PORTAL_PORT="+strconv.Itoa(cfg.PortalPort),
+	)
+	if strings.TrimSpace(cfg.Iface) != "" {
+		cmd.Env = append(cmd.Env, "HNC_PORTAL_IFACE="+strings.TrimSpace(cfg.Iface))
+	}
+	out, err := cmd.CombinedOutput()
+	if ctx.Err() == context.DeadlineExceeded {
+		return 124, "timeout"
+	}
+	if len(out) > 8192 {
+		out = out[:8192]
+	}
+	if err != nil {
+		if ee, ok := err.(*exec.ExitError); ok {
+			return ee.ExitCode(), string(out)
+		}
+		return 127, err.Error() + ": " + string(out)
+	}
+	return 0, string(out)
+}
+
+func (s *server) PortalExpiryLoop(stop <-chan struct{}) {
+	s.portalExpireOnce()
+	tick := time.NewTicker(30 * time.Second)
+	defer tick.Stop()
+	for {
+		select {
+		case <-stop:
+			return
+		case <-tick.C:
+			s.portalExpireOnce()
+		}
+	}
+}
+
+func (s *server) portalExpireOnce() {
+	now := time.Now().Unix()
+	expired := []portalSession{}
+	s.portalMu.Lock()
+	sessions := s.portalLoadSessionsUnlocked()
+	for k, sess := range sessions {
+		if sess.ExpiresAt > 0 && sess.ExpiresAt <= now {
+			expired = append(expired, sess)
+			delete(sessions, k)
+		}
+	}
+	if len(expired) > 0 {
+		if err := s.portalWriteSessionsUnlocked(sessions); err != nil {
+			log.Printf("portal expire: write sessions failed: %v", err)
+		}
+	}
+	s.portalMu.Unlock()
+	for _, sess := range expired {
+		rc, out := s.portalManager("revoke", sess.IP, sess.MAC)
+		if rc != 0 {
+			log.Printf("portal expire: revoke failed ip=%s mac=%s rc=%d out=%q", sess.IP, sess.MAC, rc, strings.TrimSpace(out))
+		}
+		s.portalAppendAudit(portalAuditEntry{Action: "expire_revoke", IP: sess.IP, MAC: sess.MAC, OK: rc == 0, Detail: strings.TrimSpace(out)})
+	}
+}
+
+func (s *server) portalResolveDevice(ip, macHint, userName string) portalDeviceInfo {
+	ip = strings.TrimSpace(ip)
+	macHint = portalNormalizeMAC(macHint)
+	info := portalDeviceInfo{IP: ip, MAC: macHint}
+	status, payload := s.buildDevicesPayload()
+	if status == 200 && payload != nil {
+		if rows, ok := payload["devices"].([]map[string]interface{}); ok {
+			for _, d := range rows {
+				mac := portalNormalizeMAC(asString(d["mac"]))
+				dip := strings.TrimSpace(asString(d["ip"]))
+				if (macHint != "" && mac == macHint) || (ip != "" && dip == ip) {
+					info = portalInfoFromDeviceMap(d, ip, macHint, userName)
+					break
+				}
+			}
+		}
+	}
+	if info.MAC == "" && ip != "" {
+		info.MAC = s.portalMACFromARP(ip)
+	}
+	if info.MAC == "" && ip != "" {
+		info.MAC = s.portalMACFromIPNeigh(ip)
+	}
+	if info.MAC != "" && (info.Name == "" || info.Vendor == "") {
+		if status == 200 && payload != nil {
+			if rows, ok := payload["devices"].([]map[string]interface{}); ok {
+				for _, d := range rows {
+					mac := portalNormalizeMAC(asString(d["mac"]))
+					if mac == info.MAC {
+						info = portalInfoFromDeviceMap(d, ip, info.MAC, userName)
+						break
+					}
+				}
+			}
+		}
+	}
+	if info.Vendor == "" && info.MAC != "" {
+		info.Vendor = s.portalVendorForMAC(info.MAC)
+	}
+	if info.Name == "" && strings.TrimSpace(userName) != "" {
+		info.Name = strings.TrimSpace(userName)
+	}
+	if info.Name == "" && info.Vendor != "" && info.MAC != "" {
+		info.Name = fmt.Sprintf("%s %s", info.Vendor, portalMACLast4(info.MAC))
+	}
+	if info.Name == "" {
+		info.Name = ip
+	}
+	return info
+}
+
+func portalInfoFromDeviceMap(d map[string]interface{}, ip, macHint, userName string) portalDeviceInfo {
+	info := portalDeviceInfo{IP: strings.TrimSpace(ip), MAC: portalNormalizeMAC(macHint)}
+	if v := strings.TrimSpace(asString(d["ip"])); v != "" && v != "-" {
+		info.IP = v
+	}
+	if v := portalNormalizeMAC(asString(d["mac"])); v != "" {
+		info.MAC = v
+	}
+	info.Vendor = firstNonEmpty(asString(d["vendor"]), asString(d["manufacturer"]), asString(d["oui"]), asString(d["device_class"]))
+	host := firstNonEmpty(asString(d["hostname"]), asString(d["name"]))
+	if host != "" {
+		info.Name = host
+	} else if strings.TrimSpace(userName) != "" {
+		info.Name = strings.TrimSpace(userName)
+	}
+	if b, ok := d["online"].(bool); ok {
+		info.Online = b
+	}
+	return info
+}
+
+func firstNonEmpty(vals ...string) string {
+	for _, v := range vals {
+		v = strings.TrimSpace(v)
+		if v != "" {
+			return v
+		}
+	}
+	return ""
+}
+
+func portalMACLast4(mac string) string {
+	m := strings.ToUpper(strings.ReplaceAll(mac, ":", ""))
+	if len(m) >= 4 {
+		return m[len(m)-4:]
+	}
+	return m
+}
+
+func (s *server) portalVendorForMAC(mac string) string {
+	mac = strings.ToUpper(strings.ReplaceAll(mac, ":", ""))
+	if len(mac) < 6 {
+		return ""
+	}
+	path := filepath.Join(s.hncDir, "data", "oui_db.json")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		data, err = os.ReadFile("/data/adb/modules/hotspot_network_control/data/oui_db.json")
+	}
+	if err != nil {
+		return ""
+	}
+	var m map[string]string
+	if json.Unmarshal(data, &m) != nil {
+		return ""
+	}
+	return m[mac[:6]]
+}
+
+func (s *server) portalMACFromARP(ip string) string {
+	f, err := os.Open("/proc/net/arp")
+	if err != nil {
+		return ""
+	}
+	defer f.Close()
+	sc := bufio.NewScanner(f)
+	for sc.Scan() {
+		fields := strings.Fields(sc.Text())
+		if len(fields) >= 4 && fields[0] == ip {
+			mac := portalNormalizeMAC(fields[3])
+			if portalValidMAC(mac) && mac != "00:00:00:00:00:00" {
+				return mac
+			}
+		}
+	}
+	return ""
+}
+
+func (s *server) portalMACFromIPNeigh(ip string) string {
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "ip", "neigh", "show", ip)
+	out, err := cmd.Output()
+	if err != nil || len(out) == 0 {
+		cmd = exec.CommandContext(ctx, "ip", "neigh")
+		out, err = cmd.Output()
+		if err != nil {
+			return ""
+		}
+	}
+	for _, line := range strings.Split(string(out), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) == 0 || fields[0] != ip {
+			continue
+		}
+		for i := 0; i+1 < len(fields); i++ {
+			if fields[i] == "lladdr" {
+				mac := portalNormalizeMAC(fields[i+1])
+				if portalValidMAC(mac) && mac != "00:00:00:00:00:00" {
+					return mac
+				}
+			}
+		}
+	}
+	return ""
+}
+
+func (s *server) portalSessionsList() []portalSession {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	m := s.portalLoadSessionsUnlocked()
+	out := make([]portalSession, 0, len(m))
+	for _, v := range m {
+		out = append(out, v)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].IP < out[j].IP })
+	return out
+}
+
+func (s *server) portalPendingList() []portalPending {
+	s.portalMu.Lock()
+	defer s.portalMu.Unlock()
+	m := s.portalLoadPendingUnlocked()
+	out := make([]portalPending, 0, len(m))
+	for _, v := range m {
+		out = append(out, v)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].UpdatedAt > out[j].UpdatedAt })
+	return out
+}
