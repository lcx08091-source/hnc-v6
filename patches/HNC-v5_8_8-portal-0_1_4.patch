diff --git a/webroot/portal.css b/webroot/portal.css
new file mode 100644
index 0000000..12cf31f
--- /dev/null
+++ b/webroot/portal.css
@@ -0,0 +1,48 @@
+:root {
+  --bg: #f7f9fb;
+  --ink: #14202b;
+  --muted: #647386;
+  --line: rgba(20,32,43,.12);
+  --panel: rgba(255,255,255,.88);
+  --blue: #1463ff;
+  --green: #0a9f5a;
+  --red: #d82f2f;
+  --admin: #fff5da;
+  --user: #e9f1ff;
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", sans-serif;
+}
+* { box-sizing: border-box; }
+body { margin:0; min-height:100vh; background:linear-gradient(180deg,#f7f9fb,#eef3f7); color:var(--ink); }
+.portal-shell { min-height:100vh; display:flex; align-items:center; justify-content:center; padding:22px; }
+.portal-panel { width:min(720px,100%); background:var(--panel); border:1px solid var(--line); border-radius:8px; box-shadow:0 18px 60px rgba(29,45,61,.12); padding:18px; }
+.portal-head { display:flex; justify-content:space-between; align-items:flex-start; gap:12px; margin-bottom:14px; }
+.eyebrow { font-size:12px; color:var(--muted); font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
+h1 { margin:2px 0 0; font-size:26px; letter-spacing:0; }
+.pill { border:1px solid var(--line); border-radius:999px; padding:6px 10px; font-size:12px; color:var(--muted); white-space:nowrap; }
+.pill.ok { color:var(--green); border-color:rgba(10,159,90,.25); background:rgba(10,159,90,.08); }
+.pill.warn { color:#a15c00; border-color:rgba(255,149,0,.28); background:rgba(255,149,0,.10); }
+.pill.err { color:var(--red); border-color:rgba(216,47,47,.25); background:rgba(216,47,47,.08); }
+.device-strip { display:grid; grid-template-columns:1.2fr 1fr 1.3fr; gap:8px; margin-bottom:14px; }
+.device-strip div { border:1px solid var(--line); border-radius:8px; padding:10px; min-width:0; background:rgba(255,255,255,.55); }
+.device-strip span { display:block; font-size:11px; color:var(--muted); margin-bottom:2px; }
+.device-strip strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:13px; }
+.chat-box { min-height:280px; max-height:46vh; overflow:auto; display:flex; flex-direction:column; gap:8px; padding:12px; border:1px solid var(--line); border-radius:8px; background:#fff; }
+.msg { max-width:84%; border-radius:8px; padding:9px 10px; font-size:14px; line-height:1.42; border:1px solid var(--line); }
+.msg .meta { font-size:11px; color:var(--muted); margin-bottom:3px; }
+.msg.user { align-self:flex-end; background:var(--user); }
+.msg.admin { align-self:flex-start; background:var(--admin); }
+.msg.system { align-self:center; background:#f4f6f8; color:var(--muted); text-align:center; }
+.login-box, .send-box { display:flex; gap:8px; margin-top:10px; }
+.login-box { display:grid; grid-template-columns:1fr; }
+input, textarea, button { font:inherit; border-radius:8px; }
+input, textarea { width:100%; border:1px solid var(--line); padding:11px 12px; background:#fff; color:var(--ink); }
+textarea { min-height:72px; resize:vertical; }
+button { border:0; background:var(--blue); color:white; font-weight:700; padding:11px 14px; cursor:pointer; }
+button:disabled { opacity:.55; cursor:not-allowed; }
+.send-box input { flex:1; }
+@media (max-width:620px) {
+  .portal-shell { padding:10px; align-items:stretch; }
+  .portal-panel { border-radius:0; min-height:calc(100vh - 20px); }
+  .device-strip { grid-template-columns:1fr; }
+  .send-box { flex-direction:column; }
+}
