diff --git a/daemon/hnc_httpd/portal_admin.go b/daemon/hnc_httpd/portal_admin.go
new file mode 100644
index 0000000..9ba9c2f
--- /dev/null
+++ b/daemon/hnc_httpd/portal_admin.go
@@ -0,0 +1,245 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+	"time"
+)
+
+func portalTokenID(r *http.Request) string {
+	if v := r.Context().Value(ctxKeyTokenID); v != nil {
+		if s, ok := v.(string); ok {
+			return s
+		}
+	}
+	if isLoopbackRequest(r) && r.Header.Get("Origin") == "" && r.Header.Get("Referer") == "" {
+		return "loopback"
+	}
+	return "admin"
+}
+
+func (s *server) apiPortalAdminSummary(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	sessions := s.portalSessionsList()
+	pending := s.portalPendingList()
+	cfg := s.portalLoadConfig()
+	writeJSON(w, http.StatusOK, map[string]interface{}{
+		"ok":             true,
+		"config":         cfg,
+		"sessions_count": len(sessions),
+		"pending_count":  len(pending),
+		"messages":       s.portalRecentMessages(20),
+	})
+}
+
+func (s *server) apiPortalAdminPending(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "pending": s.portalPendingList()})
+}
+
+func (s *server) apiPortalAdminSessions(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "sessions": s.portalSessionsList()})
+}
+
+func (s *server) apiPortalAdminMessages(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	ip := strings.TrimSpace(r.URL.Query().Get("ip"))
+	mac := portalNormalizeMAC(r.URL.Query().Get("mac"))
+	if ip != "" {
+		writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "messages": s.portalMessagesFor(ip, mac, 200)})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "messages": s.portalRecentMessages(200)})
+}
+
+func (s *server) apiPortalAdminApprove(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		IP         string `json:"ip"`
+		MAC        string `json:"mac"`
+		TTLSeconds int    `json:"ttl_seconds"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "bad json"})
+		return
+	}
+	ip := strings.TrimSpace(req.IP)
+	mac := portalNormalizeMAC(req.MAC)
+	if !portalValidIPv4(ip) {
+		writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok": false, "error": "invalid_ip"})
+		return
+	}
+	dev := s.portalResolveDevice(ip, mac, "")
+	if dev.MAC != "" {
+		mac = dev.MAC
+	}
+	if !portalValidMAC(mac) {
+		writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok": false, "error": "no_mac"})
+		return
+	}
+	cfg := s.portalLoadConfig()
+	ttl := req.TTLSeconds
+	if ttl <= 0 {
+		ttl = cfg.SessionTTLSeconds
+	}
+	now := time.Now().Unix()
+	if rc, out := s.portalManager("enable"); rc != 0 {
+		s.portalAppendAudit(portalAuditEntry{Action: "approve_enable", IP: ip, MAC: mac, OK: false, Detail: strings.TrimSpace(out), Meta: map[string]string{"tid": portalTokenID(r)}})
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "enable_failed", "detail": strings.TrimSpace(out)})
+		return
+	}
+	if rc, out := s.portalManager("allow", ip, mac); rc != 0 {
+		s.portalAppendAudit(portalAuditEntry{Action: "approve_allow", IP: ip, MAC: mac, OK: false, Detail: strings.TrimSpace(out), Meta: map[string]string{"tid": portalTokenID(r)}})
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "allow_failed", "detail": strings.TrimSpace(out)})
+		return
+	}
+	_ = s.portalSetEnabled(true)
+	if err := s.portalSaveSession(portalSession{IP: ip, MAC: mac, DeviceName: dev.Name, Vendor: dev.Vendor, CreatedAt: now, LastSeen: now, ExpiresAt: now + int64(ttl)}); err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "session_write_failed"})
+		return
+	}
+	s.portalAppendAudit(portalAuditEntry{Action: "approve", IP: ip, MAC: mac, OK: true, Meta: map[string]string{"tid": portalTokenID(r)}})
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "expires_at": now + int64(ttl)})
+}
+
+func (s *server) apiPortalAdminRevoke(w http.ResponseWriter, r *http.Request) {
+	var req struct{ IP, MAC string }
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil { writeJSON(w, http.StatusBadRequest, map[string]string{"error":"bad json"}); return }
+	ip := strings.TrimSpace(req.IP)
+	mac := portalNormalizeMAC(req.MAC)
+	if !portalValidIPv4(ip) { writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok":false,"error":"invalid_ip"}); return }
+	if mac == "" { mac = s.portalResolveDevice(ip, "", "").MAC }
+	_, _, _ = s.portalDeleteSession(ip, mac)
+	rc, out := s.portalManager("revoke", ip, mac)
+	s.portalAppendAudit(portalAuditEntry{Action: "revoke", IP: ip, MAC: mac, OK: rc == 0, Detail: strings.TrimSpace(out), Meta: map[string]string{"tid": portalTokenID(r)}})
+	if rc != 0 { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"revoke_failed","detail":strings.TrimSpace(out)}); return }
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true})
+}
+
+func (s *server) apiPortalAdminReply(w http.ResponseWriter, r *http.Request) {
+	var req struct{ IP, MAC, Message string }
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil { writeJSON(w, http.StatusBadRequest, map[string]string{"error":"bad json"}); return }
+	ip := strings.TrimSpace(req.IP)
+	mac := portalNormalizeMAC(req.MAC)
+	text, tooLong := portalTrimText(req.Message, portalChatMaxRunes)
+	if !portalValidIPv4(ip) || text == "" { writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok":false,"error":"bad_params"}); return }
+	if tooLong { writeJSON(w, http.StatusTooManyRequests, map[string]interface{}{"ok": false, "error": "rate_limited"}); return }
+	dev := s.portalResolveDevice(ip, mac, "")
+	if mac == "" { mac = dev.MAC }
+	if err := s.portalAppendChat(portalChatMessage{TS: time.Now().Unix(), IP: ip, MAC: mac, DeviceName: dev.Name, From: "admin", Text: text}); err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"write_failed"}); return
+	}
+	s.portalAppendAudit(portalAuditEntry{Action: "reply", IP: ip, MAC: mac, OK: true, Meta: map[string]string{"tid": portalTokenID(r)}})
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true})
+}
+
+func (s *server) apiPortalAdminSummon(w http.ResponseWriter, r *http.Request) {
+	var req struct{ IP, Message string }
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil { writeJSON(w, http.StatusBadRequest, map[string]string{"error":"bad json"}); return }
+	ip := strings.TrimSpace(req.IP)
+	if !portalValidIPv4(ip) { writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok":false,"error":"invalid_ip"}); return }
+	message, tooLong := portalTrimText(req.Message, portalChatMaxRunes)
+	if message == "" { message = "管理员正在呼叫你，请打开认证页面回复。" }
+	if tooLong { writeJSON(w, http.StatusTooManyRequests, map[string]interface{}{"ok": false, "error": "rate_limited"}); return }
+	dev := s.portalResolveDevice(ip, "", "")
+	if !portalValidMAC(dev.MAC) { writeJSON(w, http.StatusBadRequest, map[string]interface{}{"ok":false,"error":"no_mac"}); return }
+	now := time.Now().Unix()
+	_ = s.portalAppendChat(portalChatMessage{TS: now, IP: ip, MAC: dev.MAC, DeviceName: dev.Name, From: "admin", Text: message, Summon: true})
+	_ = s.portalUpsertPending(portalPending{IP: ip, MAC: dev.MAC, DeviceName: dev.Name, Vendor: dev.Vendor, Message: message, Summon: true, CreatedAt: now, UpdatedAt: now})
+	_, _, _ = s.portalDeleteSession(ip, dev.MAC)
+	rcRevoke, outRevoke := s.portalManager("revoke", ip, dev.MAC)
+	rcEnable, outEnable := s.portalManager("enable")
+	_ = s.portalSetEnabled(true)
+	ok := rcEnable == 0
+	detail := strings.TrimSpace(outRevoke + " " + outEnable)
+	if rcRevoke != 0 { detail = "revoke: " + strings.TrimSpace(outRevoke) + "; " + detail }
+	s.portalAppendAudit(portalAuditEntry{Action: "summon", IP: ip, MAC: dev.MAC, OK: ok, Detail: detail, Meta: map[string]string{"tid": portalTokenID(r)}})
+	if rcEnable != 0 { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"enable_failed","detail":strings.TrimSpace(outEnable)}); return }
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "revoke_rc": rcRevoke})
+}
+
+func (s *server) apiPortalAdminConfigRoute(w http.ResponseWriter, r *http.Request) {
+	if r.Method == http.MethodGet { s.apiPortalAdminConfigGet(w, r); return }
+	s.requireMutation(s.apiPortalAdminConfigPost)(w, r)
+}
+
+func (s *server) apiPortalAdminConfigGet(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "config": s.portalLoadConfig()})
+}
+
+func (s *server) apiPortalAdminConfigPost(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Enabled           *bool  `json:"enabled"`
+		Iface             string `json:"iface"`
+		PortalPort        int    `json:"portal_port"`
+		SessionTTLSeconds int    `json:"session_ttl_seconds"`
+		AutoApprove       *bool  `json:"auto_approve"`
+		Welcome           string `json:"welcome"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil { writeJSON(w, http.StatusBadRequest, map[string]string{"error":"bad json"}); return }
+	s.portalMu.Lock()
+	cfg := s.portalReadConfigUnlocked()
+	if req.Enabled != nil { cfg.Enabled = *req.Enabled }
+	if req.Iface != "" { cfg.Iface = strings.TrimSpace(req.Iface) }
+	if req.PortalPort > 0 { cfg.PortalPort = req.PortalPort }
+	if req.SessionTTLSeconds > 0 { cfg.SessionTTLSeconds = req.SessionTTLSeconds }
+	if req.AutoApprove != nil { cfg.AutoApprove = *req.AutoApprove }
+	if req.Welcome != "" { cfg.Welcome = req.Welcome }
+	err := s.portalWriteConfigUnlocked(cfg)
+	s.portalMu.Unlock()
+	if err != nil { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"write_failed"}); return }
+	if req.Enabled != nil {
+		if *req.Enabled {
+			if rc, out := s.portalManager("enable"); rc != 0 { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"enable_failed","detail":strings.TrimSpace(out)}); return }
+		} else {
+			if rc, out := s.portalManager("disable"); rc != 0 { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"disable_failed","detail":strings.TrimSpace(out)}); return }
+		}
+	}
+	s.portalAppendAudit(portalAuditEntry{Action: "config", OK: true, Meta: map[string]string{"tid": portalTokenID(r)}})
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "config": cfg})
+}
+
+func (s *server) apiPortalAdminCleanup(w http.ResponseWriter, r *http.Request) {
+	rc, out := s.portalManager("cleanup")
+	s.portalAppendAudit(portalAuditEntry{Action: "cleanup", OK: rc == 0, Detail: strings.TrimSpace(out), Meta: map[string]string{"tid": portalTokenID(r)}})
+	if rc != 0 { writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok":false,"error":"cleanup_failed","detail":strings.TrimSpace(out)}); return }
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true})
+}
+
+func (s *server) apiPortalAdminStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	rc, out := s.portalManager("status")
+	var parsed map[string]interface{}
+	if err := json.Unmarshal([]byte(strings.TrimSpace(out)), &parsed); err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "bad_status_json", "rc": rc, "detail": strings.TrimSpace(out)})
+		return
+	}
+	if rc != 0 { parsed["ok"] = false; parsed["rc"] = rc }
+	writeJSON(w, http.StatusOK, parsed)
+}
diff --git a/daemon/hnc_httpd/portal_api.go b/daemon/hnc_httpd/portal_api.go
new file mode 100644
index 0000000..f0e9a68
--- /dev/null
+++ b/daemon/hnc_httpd/portal_api.go
@@ -0,0 +1,228 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+func (s *server) registerPortalRoutes(mux *http.ServeMux) {
+	mux.HandleFunc("/portal", s.servePortalPage)
+	mux.HandleFunc("/portal.html", s.servePortalPage)
+	mux.HandleFunc("/portal.js", s.servePortalAsset)
+	mux.HandleFunc("/portal.css", s.servePortalAsset)
+	mux.HandleFunc("/api/portal/status", s.apiPortalStatus)
+	mux.HandleFunc("/api/portal/login", s.apiPortalLogin)
+	mux.HandleFunc("/api/portal/chat/send", s.apiPortalChatSend)
+	mux.HandleFunc("/api/portal/chat/poll", s.apiPortalChatPoll)
+	mux.HandleFunc("/api/portal/admin/summary", s.apiPortalAdminSummary)
+	mux.HandleFunc("/api/portal/admin/pending", s.apiPortalAdminPending)
+	mux.HandleFunc("/api/portal/admin/sessions", s.apiPortalAdminSessions)
+	mux.HandleFunc("/api/portal/admin/messages", s.apiPortalAdminMessages)
+	mux.HandleFunc("/api/portal/admin/approve", s.requireMutation(s.apiPortalAdminApprove))
+	mux.HandleFunc("/api/portal/admin/revoke", s.requireMutation(s.apiPortalAdminRevoke))
+	mux.HandleFunc("/api/portal/admin/reply", s.requireMutation(s.apiPortalAdminReply))
+	mux.HandleFunc("/api/portal/admin/summon", s.requireMutation(s.apiPortalAdminSummon))
+	mux.HandleFunc("/api/portal/admin/config", s.apiPortalAdminConfigRoute)
+	mux.HandleFunc("/api/portal/admin/cleanup", s.requireMutation(s.apiPortalAdminCleanup))
+	mux.HandleFunc("/api/portal/admin/status", s.apiPortalAdminStatus)
+}
+
+func (s *server) portalHandler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/api/portal/status", s.apiPortalStatus)
+	mux.HandleFunc("/api/portal/login", s.apiPortalLogin)
+	mux.HandleFunc("/api/portal/chat/send", s.apiPortalChatSend)
+	mux.HandleFunc("/api/portal/chat/poll", s.apiPortalChatPoll)
+	mux.HandleFunc("/portal.js", s.servePortalAsset)
+	mux.HandleFunc("/portal.css", s.servePortalAsset)
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		if strings.HasPrefix(r.URL.Path, "/api/") {
+			http.NotFound(w, r)
+			return
+		}
+		s.servePortalPage(w, r)
+	})
+	return accessLogMiddleware(mux)
+}
+
+func (s *server) servePortalPage(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet && r.Method != http.MethodHead {
+		w.Header().Set("Allow", "GET, HEAD")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Content-Security-Policy", "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'")
+	if data, ok := s.readPortalWebAsset("portal.html"); ok {
+		_, _ = w.Write(data)
+		return
+	}
+	_, _ = w.Write(portalHTML)
+}
+
+func (s *server) servePortalAsset(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet && r.Method != http.MethodHead {
+		w.Header().Set("Allow", "GET, HEAD")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	name := strings.TrimPrefix(r.URL.Path, "/")
+	switch name {
+	case "portal.js":
+		w.Header().Set("Content-Type", "application/javascript; charset=utf-8")
+		if data, ok := s.readPortalWebAsset(name); ok { _, _ = w.Write(data); return }
+		_, _ = w.Write(portalJS)
+	case "portal.css":
+		w.Header().Set("Content-Type", "text/css; charset=utf-8")
+		if data, ok := s.readPortalWebAsset(name); ok { _, _ = w.Write(data); return }
+		_, _ = w.Write(portalCSS)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (s *server) readPortalWebAsset(name string) ([]byte, bool) {
+	if strings.Contains(name, "/") || strings.Contains(name, "\\") || strings.Contains(name, "..") {
+		return nil, false
+	}
+	data, err := osReadFile(filepath.Join(s.hncDir, "webroot", name))
+	return data, err == nil && len(data) > 0
+}
+
+var osReadFile = func(path string) ([]byte, error) { return os.ReadFile(path) }
+
+func decodePortalJSON(w http.ResponseWriter, r *http.Request, out interface{}) bool {
+	if r.Method != http.MethodPost {
+		w.Header().Set("Allow", "POST")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "POST only"})
+		return false
+	}
+	if !strings.HasPrefix(r.Header.Get("Content-Type"), "application/json") {
+		writeJSON(w, http.StatusUnsupportedMediaType, map[string]string{"error": "content-type must be application/json"})
+		return false
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, mutatingMaxBytes)
+	if err := json.NewDecoder(r.Body).Decode(out); err != nil {
+		writeJSON(w, http.StatusBadRequest, map[string]string{"error": "bad json"})
+		return false
+	}
+	return true
+}
+
+func (s *server) apiPortalStatus(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	ip := ipOnly(r.RemoteAddr)
+	dev := s.portalResolveDevice(ip, "", "")
+	cfg := s.portalLoadConfig()
+	sess, authed := s.portalFindSession(ip, dev.MAC)
+	pending, hasPending := s.portalFindPending(ip, dev.MAC)
+	writeJSON(w, http.StatusOK, map[string]interface{}{
+		"ok":            true,
+		"enabled":       cfg.Enabled,
+		"authenticated": authed,
+		"ip":            ip,
+		"mac":           dev.MAC,
+		"device_name":   dev.Name,
+		"vendor":        dev.Vendor,
+		"online":        dev.Online,
+		"session":       sess,
+		"pending":       mapOrNil(hasPending, pending),
+		"messages":      s.portalMessagesFor(ip, dev.MAC, 100),
+	})
+}
+
+func mapOrNil(ok bool, v interface{}) interface{} {
+	if !ok { return nil }
+	return v
+}
+
+func (s *server) apiPortalLogin(w http.ResponseWriter, r *http.Request) {
+	var req struct {
+		Name    string `json:"name"`
+		Message string `json:"message"`
+	}
+	if !decodePortalJSON(w, r, &req) {
+		return
+	}
+	ip := ipOnly(r.RemoteAddr)
+	name, _ := portalTrimText(req.Name, 80)
+	msg, tooLong := portalTrimText(req.Message, portalChatMaxRunes)
+	if tooLong {
+		writeJSON(w, http.StatusTooManyRequests, map[string]interface{}{"ok": false, "error": "rate_limited"})
+		return
+	}
+	dev := s.portalResolveDevice(ip, "", name)
+	now := time.Now().Unix()
+	if msg != "" {
+		_ = s.portalAppendChat(portalChatMessage{TS: now, IP: ip, MAC: dev.MAC, DeviceName: dev.Name, From: "user", Text: msg})
+	}
+	if dev.MAC == "" {
+		_ = s.portalUpsertPending(portalPending{IP: ip, DeviceName: dev.Name, UserName: name, Message: msg, CreatedAt: now, UpdatedAt: now})
+		writeJSON(w, http.StatusOK, map[string]interface{}{"ok": false, "error": "mac_unresolved", "pending": true})
+		return
+	}
+	cfg := s.portalLoadConfig()
+	if cfg.AutoApprove {
+		_ = s.portalSetEnabled(true)
+		if rc, out := s.portalManager("enable"); rc != 0 {
+			writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "enable_failed", "detail": strings.TrimSpace(out)})
+			return
+		}
+		if rc, out := s.portalManager("allow", ip, dev.MAC); rc != 0 {
+			writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "allow_failed", "detail": strings.TrimSpace(out)})
+			return
+		}
+		exp := now + int64(cfg.SessionTTLSeconds)
+		_ = s.portalSaveSession(portalSession{IP: ip, MAC: dev.MAC, DeviceName: dev.Name, UserName: name, Vendor: dev.Vendor, CreatedAt: now, LastSeen: now, ExpiresAt: exp})
+		s.portalAppendAudit(portalAuditEntry{Action: "auto_approve", IP: ip, MAC: dev.MAC, OK: true})
+		writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "authenticated": true, "expires_at": exp})
+		return
+	}
+	if err := s.portalUpsertPending(portalPending{IP: ip, MAC: dev.MAC, DeviceName: dev.Name, UserName: name, Vendor: dev.Vendor, Message: msg, CreatedAt: now, UpdatedAt: now}); err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "pending_failed"})
+		return
+	}
+	s.portalAppendAudit(portalAuditEntry{Action: "login_pending", IP: ip, MAC: dev.MAC, OK: true})
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "pending": true})
+}
+
+func (s *server) apiPortalChatSend(w http.ResponseWriter, r *http.Request) {
+	var req struct{ Text string `json:"text"` }
+	if !decodePortalJSON(w, r, &req) {
+		return
+	}
+	ip := ipOnly(r.RemoteAddr)
+	text, tooLong := portalTrimText(req.Text, portalChatMaxRunes)
+	if text == "" || tooLong || !s.portalCheckChatRate(ip) {
+		writeJSON(w, http.StatusTooManyRequests, map[string]interface{}{"ok": false, "error": "rate_limited"})
+		return
+	}
+	dev := s.portalResolveDevice(ip, "", "")
+	msg := portalChatMessage{TS: time.Now().Unix(), IP: ip, MAC: dev.MAC, DeviceName: dev.Name, From: "user", Text: text}
+	if err := s.portalAppendChat(msg); err != nil {
+		writeJSON(w, http.StatusInternalServerError, map[string]interface{}{"ok": false, "error": "write_failed"})
+		return
+	}
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true})
+}
+
+func (s *server) apiPortalChatPoll(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		w.Header().Set("Allow", "GET")
+		writeJSON(w, http.StatusMethodNotAllowed, map[string]string{"error": "GET only"})
+		return
+	}
+	ip := ipOnly(r.RemoteAddr)
+	dev := s.portalResolveDevice(ip, "", "")
+	pending, hasPending := s.portalFindPending(ip, dev.MAC)
+	writeJSON(w, http.StatusOK, map[string]interface{}{"ok": true, "pending": mapOrNil(hasPending, pending), "messages": s.portalMessagesFor(ip, dev.MAC, 100)})
+}
