+<!doctype html>
+<html lang="zh-CN">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
+<meta name="theme-color" content="#f7f9fb">
+<title>HNC Portal</title>
+<link rel="stylesheet" href="/portal.css">
+</head>
+<body>
+<main class="portal-shell">
+  <section class="portal-panel">
+    <header class="portal-head">
+      <div>
+        <div class="eyebrow">HNC Portal</div>
+        <h1>热点认证</h1>
+      </div>
+      <span id="state-pill" class="pill">连接中</span>
+    </header>
+    <section class="device-strip" id="device-strip">
+      <div><span>设备</span><strong id="device-name">--</strong></div>
+      <div><span>IP</span><strong id="device-ip">--</strong></div>
+      <div><span>MAC</span><strong id="device-mac">--</strong></div>
+    </section>
+    <section class="chat-box" id="chat-box" aria-live="polite"></section>
+    <section class="login-box" id="login-box">
+      <input id="login-name" maxlength="80" autocomplete="name" placeholder="你的设备名或称呼">
+      <textarea id="login-message" maxlength="500" placeholder="给管理员的申请说明"></textarea>
+      <button id="login-btn" type="button">申请认证</button>
+    </section>
+    <section class="send-box">
+      <input id="chat-text" maxlength="500" placeholder="输入消息">
+      <button id="send-btn" type="button">发送</button>
+    </section>
+  </section>
+</main>
+<script src="/portal.js"></script>
+</body>
+</html>
diff --git a/webroot/portal.js b/webroot/portal.js
new file mode 100644
index 0000000..cfa05f0
--- /dev/null
+++ b/webroot/portal.js
@@ -0,0 +1,66 @@
+(function(){
+'use strict';
+var state = { messagesSig:'', mac:'', ip:'' };
+function $(id){ return document.getElementById(id); }
+function esc(s){ return String(s == null ? '' : s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];}); }
+function api(path, opts){
+  opts = opts || {};
+  opts.credentials = 'same-origin';
+  opts.cache = 'no-store';
+  return fetch(path, opts).then(function(r){ return r.json().catch(function(){return {};}).then(function(j){ if(!r.ok) j.http_status = r.status; return j; }); });
+}
+function setPill(cls, text){ var p=$('state-pill'); p.className='pill '+(cls||''); p.textContent=text; }
+function renderMessages(messages){
+  messages = messages || [];
+  var sig = JSON.stringify(messages.map(function(m){ return [m.id,m.ts,m.from,m.text]; }));
+  if (sig === state.messagesSig) return;
+  state.messagesSig = sig;
+  var box = $('chat-box');
+  if (!messages.length) {
+    box.innerHTML = '<div class="msg system">填写申请后，管理员可以在 HNC 后台放行或回复。</div>';
+    return;
+  }
+  box.innerHTML = messages.map(function(m){
+    var from = m.from === 'admin' ? 'admin' : (m.from === 'system' ? 'system' : 'user');
+    var who = from === 'admin' ? '管理员' : (from === 'system' ? '系统' : '我');
+    var t = m.ts ? new Date(m.ts*1000).toLocaleTimeString() : '';
+    return '<div class="msg '+from+'"><div class="meta">'+esc(who)+' '+esc(t)+'</div><div>'+esc(m.text)+'</div></div>';
+  }).join('');
+  box.scrollTop = box.scrollHeight;
+}
+function applyStatus(s){
+  state.mac = s.mac || '';
+  state.ip = s.ip || '';
+  $('device-name').textContent = s.device_name || s.ip || '--';
+  $('device-ip').textContent = s.ip || '--';
+  $('device-mac').textContent = s.mac || '等待识别';
+  if (s.authenticated) setPill('ok','已认证');
+  else if (s.pending && s.pending.summon) setPill('warn','管理员呼叫');
+  else if (s.pending) setPill('warn','等待放行');
+  else if (s.enabled === false) setPill('', 'Portal 未启用');
+  else setPill('', '未认证');
+  renderMessages(s.messages || []);
+}
+function refresh(){ api('/api/portal/status').then(applyStatus).catch(function(){ setPill('err','连接失败'); }); }
+function login(){
+  var name = $('login-name').value.trim();
+  var msg = $('login-message').value.trim();
+  $('login-btn').disabled = true;
+  api('/api/portal/login', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({name:name,message:msg}) })
+    .then(function(j){ if (j && j.error === 'mac_unresolved') setPill('err','未识别 MAC'); refresh(); })
+    .finally(function(){ $('login-btn').disabled = false; });
+}
+function send(){
+  var text = $('chat-text').value.trim();
+  if (!text) return;
+  $('send-btn').disabled = true;
+  api('/api/portal/chat/send', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({text:text}) })
+    .then(function(j){ if (j && j.error === 'rate_limited') setPill('warn','发送太快'); else $('chat-text').value=''; refresh(); })
+    .finally(function(){ $('send-btn').disabled = false; });
+}
+$('login-btn').addEventListener('click', login);
+$('send-btn').addEventListener('click', send);
+$('chat-text').addEventListener('keydown', function(e){ if(e.key==='Enter'){ e.preventDefault(); send(); }});
+refresh();
+setInterval(refresh, 3000);
+})();
