diff --git a/bin/portal_manager.sh b/bin/portal_manager.sh
new file mode 100644
index 0000000..b98bd32
--- /dev/null
+++ b/bin/portal_manager.sh
@@ -0,0 +1,159 @@
+#!/system/bin/sh
+# Native HNC Portal firewall manager. Owns only HNC_PORTAL_* chains/rules.
+
+[ -z "$HNC_SKIP_PATH_HARDENING" ] && [ -z "$HNC_TEST_MODE" ] && export PATH=/system/bin:/system/xbin:/vendor/bin:/data/local/hnc/bin:$PATH
+
+HNC_DIR=${HNC_DIR:-${HNC:-/data/local/hnc}}
+LOG="$HNC_DIR/logs/portal_manager.log"
+NAT_CHAIN=HNC_PORTAL_NAT
+FWD_CHAIN=HNC_PORTAL_FWD
+PORT=${HNC_PORTAL_PORT:-8088}
+IPT="iptables -w 2"
+
+log() {
+    mkdir -p "$HNC_DIR/logs" 2>/dev/null || true
+    printf '[%s] [PORTAL] %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$*" >> "$LOG" 2>/dev/null || true
+}
+
+valid_ip() {
+    echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
+    OLDIFS=$IFS; IFS=.; set -- $1; IFS=$OLDIFS
+    for o in "$@"; do
+        [ "$o" -ge 0 ] 2>/dev/null && [ "$o" -le 255 ] 2>/dev/null || return 1
+    done
+    return 0
+}
+
+norm_mac() { printf '%s' "$1" | tr 'A-F' 'a-f'; }
+valid_mac() { echo "$1" | tr 'A-F' 'a-f' | grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$'; }
+json_escape() {
+    case "$1" in
+        *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-]*) printf '%s' "" ;;
+        *) printf '%s' "$1" ;;
+    esac
+}
+
+detect_iface() {
+    if [ -n "$HNC_PORTAL_IFACE" ]; then printf '%s' "$HNC_PORTAL_IFACE"; return 0; fi
+    if [ -x "$HNC_DIR/bin/device_detect.sh" ]; then
+        _i=$(sh "$HNC_DIR/bin/device_detect.sh" iface 2>/dev/null)
+        _nl='
+'
+        _i=${_i%%$_nl*}
+        _cr=$(printf '\r')
+        _i=${_i%%$_cr*}
+        [ -n "$_i" ] && { printf '%s' "$_i"; return 0; }
+    fi
+    if [ -f "$HNC_DIR/run/hnc_state" ]; then
+        _s=$(cat "$HNC_DIR/run/hnc_state" 2>/dev/null)
+        case "$_s" in ACTIVE:*) printf '%s' "${_s#ACTIVE:}"; return 0 ;; esac
+    fi
+    printf '%s' wlan2
+}
+
+chain_exists() { $IPT -t "$1" -L "$2" -n >/dev/null 2>&1; }
+ensure_chain() { table="$1"; chain="$2"; chain_exists "$table" "$chain" || $IPT -t "$table" -N "$chain" 2>/dev/null || true; }
+
+ensure_tail_rules() {
+    ensure_chain nat "$NAT_CHAIN"
+    ensure_chain filter "$FWD_CHAIN"
+    $IPT -t nat -C "$NAT_CHAIN" -p tcp --dport 80 -j REDIRECT --to-ports "$PORT" 2>/dev/null \
+        || $IPT -t nat -A "$NAT_CHAIN" -p tcp --dport 80 -j REDIRECT --to-ports "$PORT"
+    $IPT -t filter -C "$FWD_CHAIN" -j REJECT --reject-with icmp-port-unreachable 2>/dev/null \
+        || $IPT -t filter -A "$FWD_CHAIN" -j REJECT --reject-with icmp-port-unreachable
+}
+
+link_exists() {
+    iface="$1"
+    $IPT -t nat -C PREROUTING -i "$iface" -p tcp --dport 80 -j "$NAT_CHAIN" >/dev/null 2>&1
+}
+
+ensure_links() {
+    iface="$1"
+    $IPT -t nat -C PREROUTING -i "$iface" -p tcp --dport 80 -j "$NAT_CHAIN" 2>/dev/null \
+        || $IPT -t nat -I PREROUTING 1 -i "$iface" -p tcp --dport 80 -j "$NAT_CHAIN"
+    $IPT -t filter -C FORWARD -i "$iface" -j "$FWD_CHAIN" 2>/dev/null \
+        || $IPT -t filter -I FORWARD 1 -i "$iface" -j "$FWD_CHAIN"
+}
+
+remove_links() {
+    iface="$1"
+    i=0; while $IPT -t nat -D PREROUTING -i "$iface" -p tcp --dport 80 -j "$NAT_CHAIN" 2>/dev/null; do i=$((i + 1)); [ "$i" -ge 100 ] && break; done
+    i=0; while $IPT -t filter -D FORWARD -i "$iface" -j "$FWD_CHAIN" 2>/dev/null; do i=$((i + 1)); [ "$i" -ge 100 ] && break; done
+}
+
+delete_rule_all() {
+    table="$1"; shift
+    i=0; while $IPT -t "$table" -D "$@" 2>/dev/null; do i=$((i + 1)); [ "$i" -ge 100 ] && break; done
+}
+
+revoke_rules() {
+    ip="$1"; mac=$(norm_mac "$2")
+    [ -n "$ip" ] && valid_ip "$ip" || return 1
+    [ -n "$mac" ] && valid_mac "$mac" || return 1
+    chain_exists nat "$NAT_CHAIN" && delete_rule_all nat "$NAT_CHAIN" -s "$ip" -m mac --mac-source "$mac" -p tcp --dport 80 -j RETURN
+    if chain_exists filter "$FWD_CHAIN"; then
+        delete_rule_all filter "$FWD_CHAIN" -s "$ip" -m mac --mac-source "$mac" -j RETURN
+        delete_rule_all filter "$FWD_CHAIN" -d "$ip" -j RETURN
+    fi
+    log "revoke ip=$ip mac=$mac"
+    return 0
+}
+
+do_enable() {
+    iface=$(detect_iface)
+    ensure_tail_rules
+    ensure_links "$iface"
+    log "enable iface=$iface port=$PORT"
+}
+
+do_disable() {
+    iface=$(detect_iface)
+    remove_links "$iface"
+    log "disable iface=$iface"
+}
+
+do_allow() {
+    ip="$1"; mac=$(norm_mac "$2")
+    [ -n "$ip" ] && valid_ip "$ip" || { log "allow invalid ip=$ip"; return 2; }
+    [ -n "$mac" ] && valid_mac "$mac" || { log "allow invalid mac=$mac"; return 2; }
+    do_enable
+    revoke_rules "$ip" "$mac" >/dev/null 2>&1 || true
+    $IPT -t nat -I "$NAT_CHAIN" 1 -s "$ip" -m mac --mac-source "$mac" -p tcp --dport 80 -j RETURN
+    $IPT -t filter -I "$FWD_CHAIN" 1 -d "$ip" -j RETURN
+    $IPT -t filter -I "$FWD_CHAIN" 1 -s "$ip" -m mac --mac-source "$mac" -j RETURN
+    log "allow ip=$ip mac=$mac"
+}
+
+do_cleanup() {
+    iface=$(detect_iface)
+    remove_links "$iface"
+    if chain_exists nat "$NAT_CHAIN"; then $IPT -t nat -F "$NAT_CHAIN" 2>/dev/null || true; $IPT -t nat -X "$NAT_CHAIN" 2>/dev/null || true; fi
+    if chain_exists filter "$FWD_CHAIN"; then $IPT -t filter -F "$FWD_CHAIN" 2>/dev/null || true; $IPT -t filter -X "$FWD_CHAIN" 2>/dev/null || true; fi
+    log "cleanup iface=$iface"
+}
+
+do_status() {
+    iface=$(detect_iface)
+    enabled=false; link_exists "$iface" && enabled=true
+    if command -v iptables-save >/dev/null 2>&1; then
+        count=$(iptables-save 2>/dev/null | grep -c 'HNC_PORTAL_' 2>/dev/null)
+    else
+        count=$({ $IPT -t nat -S 2>/dev/null; $IPT -t filter -S 2>/dev/null; } | grep -c 'HNC_PORTAL_' 2>/dev/null)
+    fi
+    case "$count" in ''|*[!0-9]*) count=0 ;; esac
+    iface_json=$(json_escape "$iface")
+    printf '{"ok":true,"enabled":%s,"iface":"%s","nat_chain":"%s","fwd_chain":"%s","rules_count":%s}\n' "$enabled" "$iface_json" "$NAT_CHAIN" "$FWD_CHAIN" "$count"
+}
+
+cmd="$1"; shift || true
+case "$cmd" in
+    enable) do_enable ;;
+    disable) do_disable ;;
+    allow) do_allow "$1" "$2" ;;
+    revoke) revoke_rules "$1" "$2" ;;
+    summon) revoke_rules "$1" "$2" >/dev/null 2>&1 || true; do_enable ;;
+    cleanup) do_cleanup ;;
+    status) do_status ;;
+    *) printf 'usage: %s {enable|disable|allow <ip> <mac>|revoke <ip> <mac>|summon <ip> <mac>|cleanup|status}\n' "$0" >&2; exit 2 ;;
+esac
